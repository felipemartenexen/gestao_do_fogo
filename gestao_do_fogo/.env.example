# This is a template for the `.env` file that is used as part of local development.
# You can copy this file, rename it to `.env` and fill in the missing values,
# then delete this header.
###############################################################################

# This file should contain all the secrets required by *development* (local) application.
# This file is ignored by git by default to avoid accidentally exposing secrets in your repository.

SECRET_KEY="django-insecure-XBeBT8uhuJJGbsNiffhqHOQq12EtbvhSt3On86y6"
# host should be "127.0.0.1" for native development or "db" for docker-based development
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/gestao_do_fogo"
# host should be "127.0.0.1" for native development or "redis" for docker-based development
REDIS_URL="redis://127.0.0.1:6379"

GOOGLE_ANALYTICS_ID=""
SENTRY_DSN=""

# Development server ports
DJANGO_PORT=8000
DJANGO_VITE_PORT=5173

# Docker service ports
POSTGRES_PORT=5432
REDIS_PORT=6379

# turnstile setup - add your keys here to enable turnstile
TURNSTILE_KEY=""
TURNSTILE_SECRET=""

ENABLE_DEBUG_TOOLBAR=True

# You can uncomment these settings to use a different email backend in settings.py.
# Depending on your selected backend, you will probably need to add additional settings / environment variables

# DEFAULT_FROM_EMAIL="felipe.martenexen@gmail.com"
# SERVER_EMAIL="noreply@localhost:8000"
# EMAIL_BACKEND="anymail.backends.mailgun.EmailBackend"
# MAILGUN_API_KEY="key-***"
# MAILGUN_SENDER_DOMAIN="example.com"

HEALTH_CHECK_TOKENS=

ANTHROPIC_API_KEY="sk-ant-***"
DEFAULT_AI_MODEL="openai:gpt-5-mini"
OPENAI_API_KEY="sk-***"

# --- Google Earth Engine ---
# Caminho do JSON da conta de serviço (mantenha o arquivo fora do repositório).
GEE_CREDENTIALS_PATH=
# Alternativa sem arquivo, para deploy:
GEE_CLIENT_EMAIL=
GEE_PRIVATE_KEY=
# Assets opcionais: enquanto vazios, o filtro de bioma e a camada de risco ficam ocultos.
GEE_BIOMAS_ASSET=
GEE_FIRE_RISK_ASSET=
